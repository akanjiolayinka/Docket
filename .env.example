# Async URL used by the FastAPI app (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://docket:docket@localhost:5432/docket

# Sync URL used by Alembic migrations (psycopg driver)
DATABASE_URL_SYNC=postgresql+psycopg://docket:docket@localhost:5432/docket

# Used by the test suite; points at a separate database so tests never touch dev data
TEST_DATABASE_URL=postgresql+asyncpg://docket:docket@localhost:5432/docket_test
TEST_DATABASE_URL_SYNC=postgresql+psycopg://docket:docket@localhost:5432/docket_test
